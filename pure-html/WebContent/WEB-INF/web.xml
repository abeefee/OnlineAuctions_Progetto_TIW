<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd" id="WebApp_ID" version="4.0">
  <display-name>TIW_Project_Biffi_Firenze_2023_Pure_HTML</display-name>
  <context-param>
    <param-name>dbUrl</param-name>
    <param-value>jdbc:mysql://localhost:3306/auction_house?serverTimezone=Europe/Rome</param-value>
  </context-param>
  <context-param>
    <param-name>dbUser</param-name>
    <param-value>root</param-value>
  </context-param>
  <context-param>
    <param-name>dbPassword</param-name>
    <param-value>alberto</param-value>
  </context-param>
  <context-param>
    <param-name>dbDriver</param-name>
    <param-value>com.mysql.cj.jdbc.Driver</param-value>
  </context-param>
  <filter>
    <filter-name>LoggedUser</filter-name>
    <filter-class>filters.LoggedUser</filter-class>
  </filter>
  <filter>
    <filter-name>NotLoggedUser</filter-name>
    <filter-class>filters.NotLoggedUser</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>NotLoggedUser</filter-name>
    <url-pattern>/</url-pattern>
    <url-pattern>/GoToLogin</url-pattern>
    <url-pattern>/GoToRegister</url-pattern>
    <url-pattern>/Login</url-pattern>
    <url-pattern>/Register</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>LoggedUser</filter-name>
    <url-pattern>/CloseAuction</url-pattern>
    <url-pattern>/CreateAuction</url-pattern>
    <url-pattern>/CreateItem</url-pattern>
    <url-pattern>/GoToAuctionBids</url-pattern>
    <url-pattern>/GoToAuctionDetail</url-pattern>
    <url-pattern>/GoToBuy</url-pattern>
    <url-pattern>/GoToSell</url-pattern>
    <url-pattern>/Logout</url-pattern>
    <url-pattern>/RegisterBid</url-pattern>
    <url-pattern>/SearchByKeyword</url-pattern>
  </filter-mapping>
</web-app>